# Local CI — runs before any push reaches GitHub, no cloud minutes spent.
# ponytail: deliberately narrower than "npm run verify" (which also runs
# check:scaffold) — that check has a pre-existing, unrelated type error in
# the scaffold template (shell-client.tsx/settings store) predating this
# hook, out of scope here. Switch to "npm run verify" once that's fixed.
npm run typecheck && npm run lint && npm test && npm run build
status=$?
if [ $status -ne 0 ]; then
  exit $status
fi

# Best-effort: post a commit status so CI is still visible in the GitHub UI,
# even though it ran locally. Never blocks the push on failure here — the
# checks above are the actual gate.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  GH_TOKEN=$(gh auth token --user mataleogml 2>/dev/null) \
    gh api -X POST "repos/mataleogml/meditor/statuses/$local_sha" \
      -f state=success -f context=ci/local -f description="local CI passed" \
      >/dev/null 2>&1 || true
done
