# ---------------------------------------------------------------------------
# /docs reminder — WARN ONLY, never blocks the commit.
#
# If a commit stages changes under src/** but nothing under docs/**, print a
# nudge to update the docs. There are NO docs in this repo yet, so this check
# deliberately only warns — it must never wedge a first commit.
#
# TO MAKE IT BLOCKING later (once docs/ exists): comment out the `echo` warning
# below and uncomment the two lines beneath it (stderr message + `exit 1`).
# ---------------------------------------------------------------------------
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if printf '%s\n' "$staged" | grep -q '^src/' && ! printf '%s\n' "$staged" | grep -q '^docs/'; then
  echo "meditor: NOTE - src/ changed but docs/ was not updated. Consider updating docs/ (warning only)."
  # To enforce instead of warn, comment the echo above and uncomment:
  # echo "meditor: src/ changed without a docs/ update - commit blocked." >&2
  # exit 1
fi

# Lint staged TS/TSX via lint-staged (eslint --fix). A non-zero exit here is
# the hook's exit code, so lint errors abort the commit.
npx lint-staged
